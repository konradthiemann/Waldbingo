# waldbingo-app — Server-Umgebungsvariablen (Beispiel)
# Der Express-Server (server/index.js) liest diese Werte aus der Umgebung.
# In Produktion (Railway) als Service-Variablen setzen; lokal optional.

# Port des Express-Servers (Default: 8787)
PORT=8787

# Verzeichnis für persistente Einladungs-Spieldaten
# (Railway: Volume-Mount; lokaler Default: server/games-data)
DATA_DIR=./server/games-data
